FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      XCO;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// CO mole fraction [-]

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        // CO is a product of incomplete combustion — small but non-zero
        type            fixedValue;
        value           uniform 0.005;
    }

    outlet
    {
        type            zeroGradient;
    }

    outerWall
    {
        type            fixedValue;
        value           uniform 0.0;
    }

    wedgeFront
    {
        type            wedge;
    }

    wedgeBack
    {
        type            wedge;
    }

    axis
    {
        type            empty;
    }
}

