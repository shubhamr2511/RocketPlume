FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      kappaBand1;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Band-averaged absorption coefficient, Band 1: MIR 5-10 µm (1000-2000 cm^-1)
// Units: 1/m

dimensions      [0 -1 0 0 0 0 0];

internalField   uniform 1e-10;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }

    outlet
    {
        type            zeroGradient;
    }

    outerWall
    {
        type            fixedValue;
        value           uniform 1e-10;
    }

    wedgeFront
    {
        type            wedge;
    }

    wedgeBack
    {
        type            wedge;
    }

    axis
    {
        type            empty;
    }
}

