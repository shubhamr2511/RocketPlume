FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Static pressure [Pa]
// Overwritten by scripts/map_plume_data.py

dimensions      [1 -1 -2 0 0 0 0];   // Pa = kg/(m·s²)

internalField   uniform 101325;       // 1 atm placeholder

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 101325;
    }

    outlet
    {
        type            zeroGradient;
    }

    outerWall
    {
        type            zeroGradient;
    }

    wedgeFront
    {
        type            wedge;
    }

    wedgeBack
    {
        type            wedge;
    }

    axis
    {
        type            empty;
    }
}

