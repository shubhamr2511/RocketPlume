FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// RTE is a first-order hyperbolic equation — upwind is required for stability
// No time derivatives needed (steady-state radiation solve)

ddtSchemes
{
    default         steadyState;
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    default         none;
    // Upwind differencing for all ray transport terms: div(Ji, Ii_h)
    // "bounded" prevents overshoot in intensity (must be non-negative)
    div(Ji,Ii_h)    bounded Gauss upwind;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
